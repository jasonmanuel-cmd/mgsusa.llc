{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/residential", "destination": "/residential-glass", "permanent": true },
    { "source": "/projects", "destination": "/gallery", "permanent": true },
    { "source": "/commercial", "destination": "/commercial-glass", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=86400" }
      ]
    }
  ]
}
