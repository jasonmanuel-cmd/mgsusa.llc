---
import { business, services, proof, steps, testimonial, nav } from '../../data/site.js';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-US">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Direction A — {business.name}</title>
<meta name="description" content={business.blurb}>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#08090B; --bg-2:#0E1014; --line:rgba(255,255,255,.10);
  --ink:#F4F6F8; --muted:#9BA3AE;
  --red:#E63946; --red-soft:rgba(230,57,70,.16);
  --glass:rgba(255,255,255,.045);
  --radius:18px;
  --shell:min(1240px,100% - 3rem);
  font-family:Inter,system-ui,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit}
.shell{width:var(--shell);margin-inline:auto}
.eyebrow{display:inline-flex;align-items:center;gap:.6rem;flex-wrap:wrap;font-size:.7rem;font-weight:700;
  letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin:0 0 1.1rem}
.eyebrow::before{content:"";width:26px;height:1px;background:var(--red)}

/* ---------- ambient field ---------- */
.aurora{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.aurora i{position:absolute;display:block;border-radius:50%;filter:blur(90px);opacity:.5}
.aurora i:nth-child(1){width:52vw;height:52vw;left:-14vw;top:-18vw;background:radial-gradient(circle,#E6394655,transparent 68%)}
.aurora i:nth-child(2){width:44vw;height:44vw;right:-12vw;top:22vh;background:radial-gradient(circle,#2B4C7E55,transparent 68%)}
.grid-lines{position:fixed;inset:0;z-index:0;pointer-events:none;
  background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);
  background-size:78px 78px;mask-image:radial-gradient(ellipse 80% 55% at 50% 0%,#000 30%,transparent 78%);opacity:.5}
main,header,footer{position:relative;z-index:1}

/* ---------- header ---------- */
header{position:sticky;top:0;z-index:40;backdrop-filter:blur(16px);
  background:rgba(8,9,11,.72);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;gap:1.6rem;height:70px}
.brand{display:flex;align-items:center;gap:.7rem;font-weight:900;letter-spacing:-.02em;text-decoration:none;font-size:1.02rem}
.brand span{display:grid;place-items:center;width:30px;height:30px;border-radius:9px;
  background:linear-gradient(140deg,var(--red),#8E1F28);font-size:.72rem;color:#fff}
nav{margin-left:auto;display:flex;gap:1.6rem}
nav a{font-size:.87rem;color:var(--muted);text-decoration:none;transition:color .18s}
nav a:hover{color:var(--ink)}
.call{display:inline-flex;align-items:center;gap:.5rem;padding:.6rem 1.05rem;border-radius:999px;
  background:var(--red);color:#fff;font-weight:700;font-size:.85rem;text-decoration:none;
  box-shadow:0 0 0 1px #ffffff14, 0 8px 26px -10px var(--red);white-space:nowrap}
@media(max-width:940px){nav{display:none}}

/* ---------- hero ---------- */
.hero{padding:clamp(4rem,11vw,8.5rem) 0 clamp(3rem,7vw,5.5rem)}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2rem,5vw,4.5rem);align-items:center}
h1{font-size:clamp(2.5rem,6.2vw,4.7rem);line-height:.98;letter-spacing:-.037em;margin:0 0 1.4rem;font-weight:900}
h1 em{font-style:normal;background:linear-gradient(100deg,var(--red),#FF8A93);-webkit-background-clip:text;background-clip:text;color:transparent}
.lede{font-size:clamp(1rem,1.7vw,1.16rem);line-height:1.62;color:var(--muted);max-width:50ch;margin:0 0 2.1rem}
.cta-row{display:flex;flex-wrap:wrap;gap:.8rem;margin-bottom:2.4rem}
.btn{display:inline-flex;align-items:center;gap:.55rem;padding:.92rem 1.5rem;border-radius:12px;
  font-weight:700;font-size:.92rem;text-decoration:none;transition:transform .18s,box-shadow .18s}
.btn-primary{background:var(--red);color:#fff;box-shadow:0 14px 34px -14px var(--red)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 20px 42px -14px var(--red)}
.btn-ghost{background:var(--glass);color:var(--ink);border:1px solid var(--line);backdrop-filter:blur(8px)}
.btn-ghost:hover{border-color:#ffffff33}
.trust{display:flex;flex-wrap:wrap;gap:1.6rem;font-size:.8rem;color:var(--muted)}
.trust b{color:var(--ink);font-weight:700}
.hero-media{position:relative;border-radius:var(--radius);overflow:hidden;
  border:1px solid var(--line);box-shadow:0 40px 90px -36px #000}
.hero-media img{display:block;width:100%;height:clamp(300px,46vw,540px);object-fit:cover}
.hero-media::after{content:"";position:absolute;inset:0;
  background:linear-gradient(200deg,transparent 40%,rgba(8,9,11,.72))}
.badge{position:absolute;left:1rem;bottom:1rem;z-index:2;display:flex;align-items:center;gap:.7rem;
  padding:.7rem 1rem;border-radius:13px;background:rgba(8,9,11,.62);border:1px solid var(--line);
  backdrop-filter:blur(14px);font-size:.8rem}
.dot{width:8px;height:8px;border-radius:50%;background:#34D399;box-shadow:0 0 0 4px #34D39926}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr}}

/* ---------- proof ---------- */
.proof{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);
  border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
.proof div{background:var(--bg-2);padding:1.5rem 1.3rem}
.proof b{display:block;font-size:clamp(1.5rem,3vw,2.1rem);font-weight:900;letter-spacing:-.03em}
.proof span{font-size:.76rem;color:var(--muted)}
@media(max-width:760px){.proof{grid-template-columns:repeat(2,1fr)}}

section{padding:clamp(3.5rem,8vw,6.5rem) 0}
h2{font-size:clamp(1.8rem,4vw,3rem);line-height:1.05;letter-spacing:-.032em;margin:0 0 1rem;font-weight:900;max-width:20ch}
.section-lede{color:var(--muted);max-width:56ch;margin:0 0 2.6rem;line-height:1.62}

/* ---------- services ---------- */
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1.1rem}
.card{position:relative;border-radius:var(--radius);border:1px solid var(--line);
  background:var(--glass);backdrop-filter:blur(10px);overflow:hidden;text-decoration:none;
  display:flex;flex-direction:column;min-height:290px;transition:border-color .22s,transform .22s}
.card:hover{transform:translateY(-4px);border-color:#ffffff2e}
.card-img{height:140px;overflow:hidden;position:relative}
.card-img img{width:100%;height:100%;object-fit:cover;opacity:.62;transition:opacity .3s,transform .5s}
.card:hover .card-img img{opacity:.85;transform:scale(1.05)}
.card-body{padding:1.25rem;display:flex;flex-direction:column;gap:.45rem;flex:1}
.card h3{margin:0;font-size:1.06rem;font-weight:800;letter-spacing:-.01em}
.card p{margin:0;font-size:.87rem;color:var(--muted);line-height:1.55}
.card .go{margin-top:auto;padding-top:.7rem;font-size:.8rem;font-weight:700;color:var(--red)}
.tag{position:absolute;top:.8rem;right:.8rem;z-index:2;padding:.28rem .6rem;border-radius:999px;
  background:var(--red);font-size:.66rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
@media(max-width:1000px){.cards{grid-template-columns:repeat(2,1fr)}}
@media(max-width:640px){.cards{grid-template-columns:1fr}}

/* ---------- process ---------- */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:1.1rem}
.step{padding:1.7rem;border-radius:var(--radius);border:1px solid var(--line);background:var(--bg-2)}
.step b{display:block;font-size:.76rem;color:var(--red);letter-spacing:.14em;margin-bottom:.9rem;font-weight:800}
.step h3{margin:0 0 .5rem;font-size:1.1rem;font-weight:800}
.step p{margin:0;color:var(--muted);font-size:.88rem;line-height:1.6}
@media(max-width:820px){.steps{grid-template-columns:1fr}}

/* ---------- quote ---------- */
.quote-wrap{border-radius:var(--radius);border:1px solid var(--line);background:var(--glass);
  backdrop-filter:blur(10px);padding:clamp(2rem,5vw,3.6rem);text-align:center}
blockquote{margin:0 auto 1.3rem;max-width:34ch;font-size:clamp(1.3rem,3vw,2rem);
  line-height:1.28;letter-spacing:-.02em;font-weight:800}
.who{color:var(--muted);font-size:.86rem}

/* ---------- final cta ---------- */
.final{border-radius:var(--radius);overflow:hidden;border:1px solid var(--line);position:relative;
  background:linear-gradient(140deg,#16181D,#0B0C0F)}
.final::before{content:"";position:absolute;width:420px;height:420px;right:-90px;top:-150px;
  border-radius:50%;background:radial-gradient(circle,var(--red-soft),transparent 66%)}
.final-in{position:relative;padding:clamp(2.2rem,6vw,4.2rem);display:grid;
  grid-template-columns:1.2fr .8fr;gap:2.4rem;align-items:center}
@media(max-width:860px){.final-in{grid-template-columns:1fr}}

footer{border-top:1px solid var(--line);padding:2.6rem 0;color:var(--muted);font-size:.83rem}
.foot{display:flex;flex-wrap:wrap;gap:1.2rem;justify-content:space-between;align-items:center}

.reveal{opacity:1}
.reveal.in{animation:rise .7s cubic-bezier(.22,.61,.36,1) both}@keyframes rise{from{opacity:.55;transform:translateY(16px)}to{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){.reveal.in{animation:none}
  html{scroll-behavior:auto}}
</style>
</head>
<body>
<div class="aurora"><i></i><i></i></div>
<div class="grid-lines"></div>

<header>
  <div class="shell bar">
    <a class="brand" href="#"><span>MGS</span> {business.name}</a>
    <nav>{nav.map(n => <a href={n.href}>{n.label}</a>)}</nav>
    <a class="call" href={business.phoneHref}>{business.phone}</a>
  </div>
</header>

<main>
  <div class="shell hero">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">Boerne &amp; San Antonio, since {business.founded}</p>
        <h1>Glass done <em>precisely</em>, or not done twice.</h1>
        <p class="lede">{business.blurb}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/request-quote">Start your quote →</a>
          <a class="btn btn-ghost" href={business.phoneHref}>Call {business.phone}</a>
        </div>
        <div class="trust">
          <span><b>{business.rating}★</b> · {business.reviews} Google reviews</span>
          <span><b>24/7</b> emergency response</span>
          <span><b>21</b> cities served</span>
        </div>
      </div>
      <div class="hero-media">
        <img src="/assets/Homehero.webp" alt="Commercial glazing on a San Antonio building" width="1400" height="932">
        <div class="badge"><span class="dot"></span> Emergency crews available now</div>
      </div>
    </div>
  </div>

  <div class="shell reveal"><div class="proof">
    {proof.map(p => <div><b>{p.figure}</b><span>{p.label}</span></div>)}
  </div></div>

  <section class="shell reveal">
    <p class="eyebrow">What we do</p>
    <h2>Built around the opening.</h2>
    <p class="section-lede">Six services, one standard. Every job starts with the measurement and the access, because that is what decides whether the glass fits and what it costs.</p>
    <div class="cards">
      {services.map(s => (
        <a class="card" href={s.slug}>
          <div class="card-img">
            {s.urgent && <span class="tag">24/7</span>}
            <img src={s.image} alt={s.name} loading="lazy" decoding="async">
          </div>
          <div class="card-body">
            <h3>{s.name}</h3>
            <p>{s.line}</p>
            <span class="go">Explore →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="shell reveal">
    <p class="eyebrow">How it works</p>
    <h2>Three steps, no guesswork.</h2>
    <div class="steps">
      {steps.map(s => <div class="step"><b>{s.n}</b><h3>{s.t}</h3><p>{s.d}</p></div>)}
    </div>
  </section>

  <section class="shell reveal">
    <div class="quote-wrap">
      <p class="eyebrow" style="justify-content:center">In their words</p>
      <blockquote>“{testimonial.quote}”</blockquote>
      <p class="who">— {testimonial.who}</p>
    </div>
  </section>

  <section class="shell reveal">
    <div class="final"><div class="final-in">
      <div>
        <h2 style="margin-bottom:.8rem">A precise next step starts with a clear conversation.</h2>
        <p class="section-lede" style="margin:0">Tell us what you are planning, repairing or replacing. We will help you identify the right path.</p>
      </div>
      <div class="cta-row" style="margin:0">
        <a class="btn btn-primary" href="/request-quote">Request a quote →</a>
        <a class="btn btn-ghost" href={business.phoneHref}>{business.phone}</a>
      </div>
    </div></div>
  </section>
</main>

<footer><div class="shell foot">
  <span>© {year} {business.name} · {business.address}</span>
  <span>{business.phone}</span>
</div></footer>

<script>
  const els = document.querySelectorAll('.reveal');
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add('in'));
  }
</script>
</body>
</html>
