---
import { business, services, proof, steps, testimonial, nav } from '../../data/site.js';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-US">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Direction B — {business.name}</title>
<meta name="description" content={business.blurb}>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#FBFAF8; --paper-2:#F2EFEA; --ink:#14161A; --muted:#5E6470;
  --line:#E1DCD4; --red:#C81E2B; --shell:min(1220px,100% - 3rem);
  --serif:Fraunces,Georgia,serif; --sans:Inter,system-ui,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit}
.shell{width:var(--shell);margin-inline:auto}
.eyebrow{display:flex;align-items:center;gap:.7rem;font-size:.7rem;font-weight:700;
  letter-spacing:.2em;text-transform:uppercase;color:var(--red);margin:0 0 1.2rem}
.eyebrow::before{content:"";width:30px;height:1px;background:var(--red)}
.serif{font-family:var(--serif);font-weight:400}

header{position:sticky;top:0;z-index:40;background:rgba(251,250,248,.86);
  backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;gap:2rem;height:76px}
.brand{font-family:var(--serif);font-size:1.16rem;font-weight:600;text-decoration:none;letter-spacing:-.01em}
.brand i{font-style:normal;color:var(--red)}
nav{margin-left:auto;display:flex;gap:1.8rem}
nav a{font-size:.85rem;color:var(--muted);text-decoration:none;padding-bottom:2px;
  border-bottom:1px solid transparent;transition:.18s}
nav a:hover{color:var(--ink);border-color:var(--red)}
.call{font-size:.85rem;font-weight:700;white-space:nowrap;text-decoration:none;border-bottom:2px solid var(--red);padding-bottom:1px}
@media(max-width:940px){nav{display:none}}

/* ---------- hero ---------- */
.hero{padding:clamp(3.5rem,9vw,7rem) 0 0}
h1{font-family:var(--serif);font-weight:400;font-size:clamp(2.6rem,6.6vw,5.4rem);
  line-height:1.02;letter-spacing:-.025em;margin:0 0 1.5rem;max-width:16ch}
h1 em{font-style:italic;color:var(--red)}
.lede{font-size:clamp(1rem,1.6vw,1.18rem);line-height:1.7;color:var(--muted);max-width:52ch;margin:0 0 2.2rem}
.cta-row{display:flex;flex-wrap:wrap;gap:.9rem;align-items:center}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.95rem 1.7rem;border-radius:2px;
  font-weight:700;font-size:.9rem;text-decoration:none;transition:.2s}
.btn-primary{background:var(--ink);color:var(--paper)}
.btn-primary:hover{background:var(--red)}
.btn-text{font-weight:700;font-size:.9rem;text-decoration:none;border-bottom:2px solid var(--red);padding-bottom:2px}
.hero-figure{margin:clamp(2.5rem,6vw,4.5rem) 0 0;position:relative}
.hero-figure img{display:block;width:100%;height:clamp(320px,52vw,620px);object-fit:cover}
.hero-cap{display:flex;flex-wrap:wrap;gap:.6rem 1.4rem;justify-content:space-between;
  padding:1rem 0;border-bottom:1px solid var(--line);font-size:.78rem;color:var(--muted)}

/* ---------- rule stats ---------- */
.proof{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--line)}
.proof div{padding:2.2rem 1.2rem 2.4rem;border-right:1px solid var(--line)}
.proof div:last-child{border-right:0}
.proof b{display:block;font-family:var(--serif);font-weight:600;
  font-size:clamp(1.9rem,4vw,2.8rem);letter-spacing:-.03em;line-height:1;margin-bottom:.45rem}
.proof span{font-size:.76rem;color:var(--muted);letter-spacing:.02em}
@media(max-width:760px){.proof{grid-template-columns:repeat(2,1fr)}
  .proof div:nth-child(2n){border-right:0}
  .proof div:nth-child(-n+2){border-bottom:1px solid var(--line)}}

section{padding:clamp(4rem,9vw,7rem) 0}
h2{font-family:var(--serif);font-weight:400;font-size:clamp(2rem,4.4vw,3.4rem);
  line-height:1.08;letter-spacing:-.025em;margin:0 0 1.1rem;max-width:18ch}
.section-lede{color:var(--muted);max-width:56ch;line-height:1.72;margin:0 0 3rem}

/* ---------- services ---------- */
.svc{border-top:1px solid var(--line)}
.svc a{display:grid;grid-template-columns:5.5rem 1fr 1fr auto;gap:2rem;align-items:center;
  padding:1.7rem 0;border-bottom:1px solid var(--line);text-decoration:none;transition:.22s}
.svc a:hover{padding-left:1rem;padding-right:1rem;background:var(--paper-2)}
.svc .num{font-family:var(--serif);font-size:.95rem;color:var(--muted)}
.svc h3{margin:0;font-family:var(--serif);font-weight:600;font-size:1.34rem;letter-spacing:-.015em}
.svc p{margin:0;font-size:.9rem;color:var(--muted);line-height:1.6}
.svc .arrow{font-size:1.1rem;color:var(--red);transition:transform .22s}
.svc a:hover .arrow{transform:translateX(5px)}
.urgent{display:inline-block;margin-left:.55rem;padding:.2rem .5rem;background:var(--red);color:#fff;
  border-radius:2px;font-family:var(--sans);font-size:.6rem;font-weight:800;letter-spacing:.1em;vertical-align:middle}
@media(max-width:900px){.svc a{grid-template-columns:2.5rem 1fr auto;gap:1rem}
  .svc a p:last-of-type{display:none}}

/* ---------- split ---------- */
.split{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,5rem);align-items:center}
.split img{width:100%;height:clamp(300px,42vw,500px);object-fit:cover}
@media(max-width:880px){.split{grid-template-columns:1fr}}

.steps{display:grid;gap:0}
.step{display:grid;grid-template-columns:4.5rem 1fr;gap:1.6rem;padding:1.8rem 0;border-top:1px solid var(--line)}
.step b{font-family:var(--serif);font-size:1.5rem;color:var(--red);font-weight:600}
.step h3{margin:0 0 .35rem;font-size:1.06rem;font-weight:700}
.step p{margin:0;color:var(--muted);font-size:.9rem;line-height:1.62}

/* ---------- quote ---------- */
.pull{background:var(--paper-2);padding:clamp(3rem,8vw,6rem) 0}
blockquote{margin:0 auto;max-width:22ch;font-family:var(--serif);font-weight:400;
  font-size:clamp(1.7rem,4.4vw,3rem);line-height:1.22;letter-spacing:-.022em;text-align:center}
.who{text-align:center;margin:1.6rem 0 0;font-size:.84rem;color:var(--muted)}

.final{border-top:1px solid var(--line);padding:clamp(3rem,8vw,6rem) 0}
.final-in{display:grid;grid-template-columns:1.25fr .75fr;gap:2.6rem;align-items:end}
@media(max-width:860px){.final-in{grid-template-columns:1fr;align-items:start}}

footer{border-top:1px solid var(--line);padding:2.4rem 0;font-size:.8rem;color:var(--muted)}
.foot{display:flex;flex-wrap:wrap;gap:1rem;justify-content:space-between}

.reveal{opacity:1}
.reveal.in{animation:rise .7s cubic-bezier(.22,.61,.36,1) both}@keyframes rise{from{opacity:.55;transform:translateY(16px)}to{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){.reveal.in{animation:none}
  html{scroll-behavior:auto}}
</style>
</head>
<body>

<header>
  <div class="shell bar">
    <a class="brand" href="#">Master Glass <i>Solutions</i></a>
    <nav>{nav.map(n => <a href={n.href}>{n.label}</a>)}</nav>
    <a class="call" href={business.phoneHref}>{business.phone}</a>
  </div>
</header>

<main>
  <div class="shell hero">
    <p class="eyebrow">Boerne &amp; San Antonio · since {business.founded}</p>
    <h1>Precision is visible. So is <em>the lack of it.</em></h1>
    <p class="lede">{business.blurb}</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/request-quote">Start your quote</a>
      <a class="btn-text" href={business.phoneHref}>or call {business.phone}</a>
    </div>
    <figure class="hero-figure">
      <img src="/assets/Homehero.webp" alt="Commercial glazing on a San Antonio building" width="1400" height="932">
      <figcaption class="hero-cap">
        <span>Architectural glazing · San Antonio, TX</span>
        <span>{business.rating}★ · {business.reviews} Google reviews · 24/7 emergency</span>
      </figcaption>
    </figure>
  </div>

  <div class="shell reveal"><div class="proof">
    {proof.map(p => <div><b>{p.figure}</b><span>{p.label}</span></div>)}
  </div></div>

  <section class="shell reveal">
    <p class="eyebrow">What we do</p>
    <h2>Built around the opening. Guided by the details.</h2>
    <p class="section-lede">Every job starts with the measurement and the access, because that is what decides whether the glass fits and what it ends up costing.</p>
    <div class="svc">
      {services.map((s, i) => (
        <a href={s.slug}>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.name}{s.urgent && <span class="urgent">24/7</span>}</h3>
          <p>{s.line}</p>
          <span class="arrow">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="shell reveal">
    <div class="split">
      <img src="/assets/insidemgs.webp" alt="Staff at the reception desk inside the Master Glass Solutions office" loading="lazy" decoding="async">
      <div>
        <p class="eyebrow">How it works</p>
        <h2>Three steps, no guesswork.</h2>
        <div class="steps">
          {steps.map(s => <div class="step"><b>{s.n}</b><div><h3>{s.t}</h3><p>{s.d}</p></div></div>)}
        </div>
      </div>
    </div>
  </section>

  <div class="pull reveal"><div class="shell">
    <blockquote>“{testimonial.quote}”</blockquote>
    <p class="who">— {testimonial.who}</p>
  </div></div>

  <div class="final reveal"><div class="shell final-in">
    <div>
      <p class="eyebrow">Next step</p>
      <h2 style="margin-bottom:0">A precise next step starts with a clear conversation.</h2>
    </div>
    <div>
      <p class="section-lede" style="margin-bottom:1.6rem">Tell us what you are planning, repairing or replacing.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/request-quote">Request a quote</a>
        <a class="btn-text" href={business.phoneHref}>{business.phone}</a>
      </div>
    </div>
  </div></div>
</main>

<footer><div class="shell foot">
  <span>© {year} {business.name} · {business.address}</span>
  <span>{business.phone}</span>
</div></footer>

<script>
  const els = document.querySelectorAll('.reveal');
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add('in'));
  }
</script>
</body>
</html>
