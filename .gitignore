# Dependencies
node_modules/

# Environment / secrets - never commit credentials
.env
.env.local
.env.*
!.env.example

# Working/scratch files
assets/candidate-*.jpg
assets/*-real.jpg
assets/*-stock.jpg
temp-*.html
*-AUDIT-REPORT.md
*-AUDIT.md
*-REVIEW.md
.vercel

# scratch/dev files
_*.py
_*.txt
*.py
lighthouse-*.json
DEPLOYMENT_SUMMARY.txt
*_REPORT.md
*_SUMMARY.md

# scratch QA/diagnostics
diag*.mjs
shots.mjs
shots/
master-glass-site/
.env*

# Skills ship their own Python helpers. The blanket *.py above exists to keep
# stray build scripts out of the repo, not to exclude bundled skill tooling.
!.claude/skills/**/*.py

# Same reasoning for tools/. These are deliberate, re-runnable, idempotent
# scripts that encode why a site-wide edit was made the way it was, and
# CLAUDE.md tells people to run some of them by name -- fix_place_geo.py to
# repair city-page Place geo, fix_hours_conflict.py to converge the opening
# hours. The blanket *.py above was silently excluding every one of them, so
# the documentation referred to files a fresh clone did not contain. The .cjs
# checks in the same folder were tracked all along, which is the inconsistency
# that hid this.
#
# Nothing here reaches the live site: .vercelignore excludes tools/ entirely.
!tools/*.py

# Python cache
__pycache__/
*.pyc
